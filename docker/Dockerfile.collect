# Dockerfile.collect — Container for RF protocol decoders
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    python3 \
    python3-pip \
    multimon-ng \
    direwolf \
    rtl-433 \
    sox \
    libfftw3-dev \
    libsamplerate0-dev \
    libusb-1.0-0-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
CMD ["bash"]
